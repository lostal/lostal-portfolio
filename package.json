{
  "name": "lostal-portafolio",
  "version": "1.0.0",
  "description": "Portafolio profesional con Astro",
  "author": "Álvaro Lostal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lostal/lostal-portafolio"
  },
  "type": "module",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run check && astro build && pnpm run generate:cv",
    "preview": "astro preview",
    "check": "astro check",
    "generate:cv": "tsx scripts/generate-cv.ts",
    "clean": "node -e \"import{rmSync}from'node:fs';['dist','.astro'].forEach(d=>rmSync(d,{recursive:true,force:true}))\" --input-type=module",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.2",
    "lenis": "^1.3.23"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/serve-handler": "^6.1.4",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "astro-eslint-parser": "^2.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^2.1.0",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "puppeteer": "^25.2.1",
    "serve-handler": "^6.1.7",
    "sharp": "^0.35.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
