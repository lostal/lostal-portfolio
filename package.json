{
  "name": "lostal-portafolio",
  "version": "1.0.0",
  "description": "Portafolio profesional con Astro",
  "author": "Álvaro Lostal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lostal/lostal-portafolio"
  },
  "type": "module",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm run check && astro build && pnpm run generate:cv",
    "preview": "astro preview",
    "check": "astro check",
    "generate:cv": "tsx scripts/generate-cv.ts",
    "clean": "node -e \"const fs=require('fs');['dist','.astro'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/sitemap": "^3.6.1",
    "astro": "^5.16.9",
    "lenis": "^1.3.17",
    "swiper": "^12.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/serve-handler": "^6.1.4",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "astro-eslint-parser": "^1.2.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.8.0",
    "prettier-plugin-astro": "^0.14.1",
    "puppeteer": "^24.35.0",
    "serve-handler": "^6.1.6",
    "sharp": "^0.34.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
