---
import '../styles/variables.css';
import '../styles/global.css';

export interface Props {
  lang?: 'es' | 'en';
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  lang = 'es',
  title: propTitle,
  description: propDescription,
  ogImage: propOgImage,
} = Astro.props;

const title = propTitle || 'Álvaro Lostal - Portafolio';
const description =
  propDescription ||
  'Portafolio profesional de Álvaro Lostal, desarrollador web e ingeniero informático.';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const defaultOgImage = new URL('/assets/og/azulejos.jpg', Astro.site).href;
const ogImage = propOgImage || defaultOgImage;

// Calcular URLs alternativas para hreflang dinámicamente
const currentPath = Astro.url.pathname;
const siteBase = Astro.site?.href || 'https://lostal.dev';

// Determinar las rutas equivalentes en cada idioma
const getAlternateUrls = (path: string, currentLang: 'es' | 'en') => {
  let esPath: string;
  let enPath: string;

  if (currentLang === 'en') {
    // Estamos en /en/*, quitar el prefijo /en para obtener la versión española
    esPath = path.replace(/^\/en\/?/, '/') || '/';
    enPath = path;
  } else {
    // Estamos en la raíz (español), añadir /en/ para la versión inglesa
    esPath = path;
    enPath = path === '/' ? '/en/' : `/en${path}`;
  }

  // Normalizar trailing slashes
  esPath = esPath === '/' ? '/' : esPath.replace(/\/$/, '') + '/';
  enPath = enPath.endsWith('/') ? enPath : enPath + '/';

  return {
    es: new URL(esPath, siteBase).href,
    en: new URL(enPath, siteBase).href,
  };
};

const alternateUrls = getAlternateUrls(currentPath, lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Seguridad -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Preload Geist fonts (WOFF2) -->
    <link
      rel="preload"
      href="/assets/geist/Geist-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/geist/Geist-SemiBold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/geist/GeistMono-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Hreflang for internationalization - URLs dinámicas -->
    <link rel="alternate" hreflang="es" href={alternateUrls.es} />
    <link rel="alternate" hreflang="en" href={alternateUrls.en} />
    <link rel="alternate" hreflang="x-default" href={alternateUrls.en} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta
      property="og:site_name"
      content={lang === 'es'
        ? 'Álvaro Lostal - Portafolio'
        : 'Álvaro Lostal - Portfolio'}
    />

    <!-- Twitter/X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@lostalvaro" />
    <meta name="twitter:creator" content="@lostalvaro" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- JSON-LD Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            '@id': 'https://lostal.dev/#website',
            url: 'https://lostal.dev',
            name:
              lang === 'es'
                ? 'Álvaro Lostal - Portafolio'
                : 'Álvaro Lostal - Portfolio',
            description:
              lang === 'es'
                ? 'Portafolio profesional de Álvaro Lostal, desarrollador web e ingeniero informático.'
                : 'Professional portfolio of Álvaro Lostal, web developer and computer engineer.',
            inLanguage: lang === 'es' ? 'es-ES' : 'en-US',
          },
          {
            '@type': 'Person',
            '@id': 'https://lostal.dev/#person',
            name: 'Álvaro Lostal',
            url: 'https://lostal.dev',
            jobTitle: lang === 'es' ? 'Desarrollador Web' : 'Web Developer',
            description:
              lang === 'es'
                ? 'Ingeniero Informático especializado en desarrollo web, diseño de interfaces minimalistas y UX.'
                : 'Computer Engineer specialized in web development, minimalist interface design and UX.',
            knowsAbout: [
              'HTML',
              'CSS',
              'JavaScript',
              'TypeScript',
              'Astro',
              'React',
              'Node.js',
              'SEO',
              'UX/UI Design',
              'Accessibility',
            ],
            alumniOf: {
              '@type': 'CollegeOrUniversity',
              name: 'Universidad Europea del Atlántico',
              location: 'Santander, España',
            },
            knowsLanguage: [
              {
                '@type': 'Language',
                name: 'Spanish',
                alternateName: 'es',
              },
              {
                '@type': 'Language',
                name: 'English',
                alternateName: 'en',
                proficiencyLevel: 'B2',
              },
            ],
            sameAs: [
              'https://github.com/lostal',
              'https://linkedin.com/in/alvarolostal',
              'https://twitter.com/lostalvaro',
            ],
          },
        ],
      })}
    />

    <!-- Font Awesome Subset - Preload fonts first -->
    <link
      rel="preload"
      href="/assets/fontawesome/fa-solid-900.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fontawesome/fa-brands-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fontawesome/fa-subset.css"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href="/assets/fontawesome/fa-subset.css" />
    </noscript>

    <!-- Inline theme setter (very small, prevents flash) -->
    <script is:inline>
      try {
        const prefersDark =
          window.matchMedia &&
          window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = prefersDark ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.style.colorScheme = theme;
        // Update theme-color metas for iOS Safari
        document.querySelectorAll('meta[name="theme-color"]').forEach(m => {
          m.content = prefersDark ? '#000000' : '#fafaf9';
        });
      } catch {
        // no-op
      }
    </script>
    <!-- Favicons: configuración equilibrada y común en sitios de portafolio -->
    <!-- Raíz .ico (soporte legacy y fallback) -->
    <link rel="icon" href="/favicon.ico" />
    <!-- SVG fuente (alta calidad, navegadores que lo soportan) -->
    <link rel="icon" type="image/svg+xml" href="/assets/favicons/favicon.svg" />
    <!-- PNGs para navegadores/servicios que prefieren bitmap, tamaños comunes -->
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/assets/favicons/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/assets/favicons/favicon-16x16.png"
    />
    <!-- iOS touch icon -->
    <link rel="apple-touch-icon" href="/assets/favicons/apple-touch-icon.png" />
    <!-- Theme color for iOS Safari - needs both with media queries -->
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fafaf9"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000000"
    />
    <meta name="theme-color" content="#fafaf9" />
  </head>
  <body>
    <a href="#main" class="skip-link"
      >{
        lang === 'es' ? 'Saltar al contenido principal' : 'Skip to main content'
      }</a
    >

    <!-- Elemento para notificaciones relacionadas con el tema (controlado por theme.js) -->
    <div id="theme-notification" class="theme-notification" aria-hidden="true">
    </div>

    <slot />

    <script src="../scripts/lenis.ts"></script>
    <script src="../scripts/animations.ts"></script>
    <script src="../scripts/hero-parallax.ts"></script>
    <script src="../scripts/navigation.ts"></script>
    <script src="../scripts/theme.ts"></script>
  </body>
</html>
