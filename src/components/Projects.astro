---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

type Project = CollectionEntry<'projects'>;
const projects = (await getCollection('projects')).sort(
  (a: Project, b: Project) => a.data.order - b.data.order
);
---

<section class="projects-section" id="projects">
  <div class="wrapper">
    <div class="section-header fade-in">
      <div class="section-divider divider-slider"></div>
      <h2 class="section-title">{t('projects.title')}</h2>
      <p class="section-description">
        {t('projects.description')}
      </p>
    </div>
  </div>

  <div class="projects-scroll" role="region" aria-label={t('projects.title')}>
    {
      projects.map((project: Project) => {
        const { data } = project;
        const translation = data.translations[lang];

        return (
          <article class="carousel-item" aria-label={translation.title}>
            <Picture
              src={data.image}
              alt={data.imageAlt}
              widths={[400, 640, 800, 960]}
              sizes="(max-width: 480px) 92vw, (max-width: 768px) 85vw, (max-width: 1024px) 70vw, 800px"
              formats={['avif', 'webp']}
              quality={85}
              loading="lazy"
              decoding="async"
              class="carousel-item__image"
            />

            <div class="carousel-item__content">
              <div class="carousel-item__tech">
                {data.technologies.map(
                  (tech: { name: string; icon: string }) => (
                    <span class="tag">
                      <img
                        src={tech.icon}
                        alt={tech.name}
                        class="tech-mini-icon"
                        width="14"
                        height="14"
                        loading="lazy"
                      />
                      {tech.name}
                    </span>
                  )
                )}
              </div>

              <div class="carousel-item__info">
                <h2 class="carousel-item__title">{translation.title}</h2>
                <div class="carousel-item__text">{translation.description}</div>
              </div>

              <div class="carousel-item__actions">
                {data.liveUrl && (
                  <a
                    class="carousel-item__action"
                    href={data.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <i
                      class="fas fa-arrow-up-right-from-square"
                      aria-hidden="true"
                    />
                    <span>{translation.preview}</span>
                  </a>
                )}
                <a
                  class="carousel-item__action"
                  href={data.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <i class="fab fa-github" aria-hidden="true" />
                  <span>{t('projects.more')}</span>
                </a>
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  #projects {
    position: relative;
  }

  .divider-slider::before {
    content: '>>>';
    animation: flow-output 1.8s step-end infinite;
  }

  @keyframes flow-output {
    0%,
    25% {
      content: '>';
    }
    25%,
    50% {
      content: '>>';
    }
    50%,
    100% {
      content: '>>>';
    }
  }

  .projects-section .wrapper {
    max-width: 1560px;
    margin: 0 auto;
    padding: 0 24px;
  }

  @media (min-width: 768px) {
    .projects-section .wrapper {
      padding: 0 48px;
    }
  }

  @media (max-width: 600px) {
    .projects-section .wrapper {
      padding: 0 28px;
    }
  }

  @media (max-width: 480px) {
    .projects-section .wrapper {
      padding: 0 24px;
    }
  }

  section.projects-section {
    padding-left: 0;
    padding-right: 0;
  }

  @media (min-width: 1024px) {
    section.projects-section {
      padding-left: 24px;
      padding-right: 24px;
    }
  }

  /* ── Vertical stack container ── */

  .projects-scroll {
    --sticky-base: 100px;
    --sticky-step: 18px;
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0 24px;
  }

  @media (min-width: 768px) {
    .projects-scroll {
      --sticky-base: 120px;
      --sticky-step: 22px;
      padding: 0 48px;
    }
  }

  @media (min-width: 1024px) {
    .projects-scroll {
      --sticky-base: 140px;
      --sticky-step: 26px;
      padding: 0 56px;
    }
  }

  /* ── Card ── */

  .carousel-item {
    width: 100%;
    max-width: 440px;
    margin-left: auto;
    margin-right: auto;
    position: sticky;
    top: calc(var(--sticky-base) + var(--sticky-offset, 0px));
    background: var(--bg-secondary);
    border-radius: 20px;
    border: 1px solid var(--border);
    overflow: hidden;
    margin-bottom: 24px;
  }

  .carousel-item:last-child {
    margin-bottom: 80px;
  }

  .carousel-item:nth-child(1) { --sticky-offset: calc(var(--sticky-step) * 0); z-index: 1; }
  .carousel-item:nth-child(2) { --sticky-offset: calc(var(--sticky-step) * 1); z-index: 2; }
  .carousel-item:nth-child(3) { --sticky-offset: calc(var(--sticky-step) * 2); z-index: 3; }
  .carousel-item:nth-child(4) { --sticky-offset: calc(var(--sticky-step) * 3); z-index: 4; }
  .carousel-item:nth-child(5) { --sticky-offset: calc(var(--sticky-step) * 4); z-index: 5; }
  .carousel-item:nth-child(6) { --sticky-offset: calc(var(--sticky-step) * 5); z-index: 6; }
  .carousel-item:nth-child(7) { --sticky-offset: calc(var(--sticky-step) * 6); z-index: 7; }
  .carousel-item:nth-child(8) { --sticky-offset: calc(var(--sticky-step) * 7); z-index: 8; }

  @media (min-width: 480px) {
    .carousel-item { max-width: 540px; }
  }

  @media (min-width: 768px) {
    .carousel-item {
      max-width: 680px;
      margin-bottom: 64px;
    }
  }

  @media (min-width: 1024px) {
    .carousel-item {
      max-width: 860px;
      margin-bottom: 96px;
    }
  }

  @media (min-width: 1280px) {
    .carousel-item { max-width: 900px; }
  }

  /* ── Image ── */

  .carousel-item__image {
    aspect-ratio: 400 / 270;
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  /* ── Content ── */

  .carousel-item__content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px 20px;
  }

  @media screen and (min-width: 1440px) {
    .carousel-item__content {
      gap: 24px;
      padding: 28px 24px;
    }
  }

  @media screen and (max-width: 767px) {
    .carousel-item__content {
      gap: 16px;
      padding: 16px 14px;
    }
  }

  /* ── Tech tags ── */

  .carousel-item__tech {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .carousel-item__tech .tech-mini-icon,
  .carousel-item__tech img.tech-mini-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  /* ── Title (line-clamp 2) ── */

  .carousel-item__title {
    font-weight: var(--font-weight-semibold);
    font-size: var(--font-size-xl);
    line-height: 1.2;
    margin-bottom: 8px;
    color: var(--text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  @media screen and (min-width: 1920px) {
    .carousel-item__title {
      font-size: 22px;
      margin-bottom: 10px;
    }
  }

  @media screen and (min-width: 1440px) and (max-width: 1919px) {
    .carousel-item__title {
      font-size: 21px;
      margin-bottom: 9px;
    }
  }

  @media screen and (max-width: 768px) {
    .carousel-item__title {
      font-size: 18px;
      margin-bottom: 6px;
    }
  }

  /* ── Description (line-clamp 3) ── */

  .carousel-item__text {
    font-weight: 300;
    font-size: var(--font-size-base);
    line-height: 1.5;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media screen and (min-width: 1920px) {
    .carousel-item__text {
      font-size: 17px;
      line-height: 1.5;
    }
  }

  @media screen and (min-width: 1440px) and (max-width: 1919px) {
    .carousel-item__text {
      font-size: 16px;
    }
  }

  @media screen and (max-width: 768px) {
    .carousel-item__text {
      font-size: 14px;
      line-height: 1.4;
    }
  }

  /* ── Action links ── */

  .carousel-item__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .carousel-item__action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: var(--bg-secondary);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: all var(--animation-duration) ease;
  }

  .carousel-item__action i {
    font-size: 14px;
  }

  @media (hover: hover) and (pointer: fine) {
    .carousel-item__action:hover {
      background: var(--accent-primary);
      color: var(--text-on-accent);
      border-color: var(--accent-primary);
    }
  }
</style>
