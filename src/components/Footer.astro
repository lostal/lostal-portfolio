---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="footer-main">
    <!-- Ubicación + Hora local con flip clock animation -->
    <div class="footer-location-time">
      <span class="footer-location">Santander, ES</span>
      <span class="footer-time-separator">·</span>
      <span class="footer-time flip-clock" id="footer-local-time">
        <span class="flip-digit" data-digit="h1"
          ><span class="flip-digit__inner">-</span></span
        >
        <span class="flip-digit" data-digit="h2"
          ><span class="flip-digit__inner">-</span></span
        >
        <span class="flip-colon">:</span>
        <span class="flip-digit" data-digit="m1"
          ><span class="flip-digit__inner">-</span></span
        >
        <span class="flip-digit" data-digit="m2"
          ><span class="flip-digit__inner">-</span></span
        >
      </span>
      <span class="footer-timezone">CET</span>
    </div>

    <!-- Navegación rediseñada - estilo técnico con índices -->
    <nav class="footer-nav" aria-label={t('footer.nav.aria')}>
      <ul class="footer-nav-list">
        <li>
          <span class="nav-index">01</span>
          <a href="#projects">{t('nav.projects')}</a>
        </li>
        <li>
          <span class="nav-index">02</span>
          <a href="#journey">{t('nav.journey')}</a>
        </li>
        <li>
          <span class="nav-index">03</span>
          <a href="#technologies">{t('nav.technologies')}</a>
        </li>
        <li>
          <span class="nav-index">04</span>
          <a href="#contact">{t('nav.contact')}</a>
        </li>
      </ul>
    </nav>
  </div>

  <!-- Línea discontinua -->
  <div class="footer-divider"></div>

  <!-- Firma y metadata -->
  <div class="footer-bottom">
    <span class="footer-signature">
      {t('footer.signature')}
      <strong class="footer-name" title="👋">Álvaro Lostal</strong>
    </span>
    <span class="footer-version">{t('footer.version')} · {currentYear}</span>
  </div>
</footer>

<style>
  /* Footer Grid Editorial - Estilo técnico */
  footer {
    background: var(--bg-primary);
    border-top: 1px solid var(--border);
    padding: 64px 24px 48px;
  }

  .footer-main {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 48px;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .footer-main {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 48px;
    }
  }

  /* Ubicación + Hora local */
  .footer-location-time {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.3px;
    color: var(--text-secondary);
  }

  .footer-location {
    color: var(--text-secondary);
  }

  .footer-time-separator {
    opacity: 0.4;
  }

  .footer-time {
    font-variant-numeric: tabular-nums;
    min-width: 40px;
    display: inline-flex;
    gap: 1px;
  }

  .flip-digit {
    position: relative;
    display: inline-block;
    overflow: hidden;
    height: 1.3em;
    min-width: 0.7em;
    text-align: center;
  }

  .flip-digit__inner {
    display: block;
    transition: transform 0.1s ease;
  }

  .flip-digit.is-flipping .flip-digit__inner {
    animation: flip-down 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes flip-down {
    0% {
      transform: translateY(-100%);
      opacity: 0;
    }
    30% {
      opacity: 0.5;
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .flip-colon {
    opacity: 0.6;
    animation: blink-colon 1s step-end infinite;
  }

  @keyframes blink-colon {
    0%,
    50% {
      opacity: 0.6;
    }
    51%,
    100% {
      opacity: 0.2;
    }
  }

  .footer-timezone {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-secondary);
  }

  /* Navegación con índices - estilo técnico/editorial */
  .footer-nav {
    display: flex;
    align-items: center;
  }

  .footer-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 480px) {
    .footer-nav-list {
      gap: 24px;
    }
  }

  .footer-nav-list li {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .nav-index {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-secondary);
    letter-spacing: 0.5px;
  }

  .footer-nav-list a {
    font-size: var(--font-size-sm);
    color: var(--text-secondary);
    text-decoration: none;
    letter-spacing: 0.2px;
    transition: color var(--animation-duration) ease;
    position: relative;
  }

  .footer-nav-list a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--text-primary);
    transition: width var(--animation-duration) ease;
  }

  @media (hover: hover) {
    .footer-nav-list a:hover {
      color: var(--text-primary);
    }

    .footer-nav-list a:hover::after {
      width: 100%;
    }

    .footer-nav-list li:hover .nav-index {
      opacity: 1;
    }
  }

  /* Línea discontinua */
  .footer-divider {
    max-width: 1200px;
    margin: 48px auto;
    height: 1px;
    background: repeating-linear-gradient(
      to right,
      var(--border) 0,
      var(--border) 8px,
      transparent 8px,
      transparent 16px
    );
  }

  /* Footer Bottom */
  .footer-bottom {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  @media (max-width: 768px) {
    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }
  }

  .footer-signature {
    font-size: 13px;
    color: var(--text-secondary);
    letter-spacing: 0.2px;
  }

  .footer-signature strong,
  .footer-name {
    color: var(--text-secondary);
    font-weight: var(--font-weight-medium);
    cursor: default;
    transition: all var(--animation-duration) ease;
    display: inline-block;
  }

  /* Easter egg: name animation on hover */
  @media (hover: hover) {
    .footer-name:hover {
      color: var(--accent-primary);
      animation: easter-egg-wave 0.6s ease;
    }
  }

  @keyframes easter-egg-wave {
    0%,
    100% {
      transform: rotate(0deg);
    }
    20% {
      transform: rotate(-8deg) scale(1.05);
    }
    40% {
      transform: rotate(6deg);
    }
    60% {
      transform: rotate(-4deg);
    }
    80% {
      transform: rotate(2deg);
    }
  }

  /* Respetar movimiento reducido */
  @media (prefers-reduced-motion: reduce) {
    .footer-name {
      animation: none;
      transition: none;
    }
  }

  .footer-version {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--text-secondary);
    letter-spacing: 0.5px;
  }
</style>

<script>
  // Flip Clock - Hora local de Santander con flip animation
  const flipClock = {
    lastValues: { h1: '', h2: '', m1: '', m2: '' },

    init() {
      this.update();
      setInterval(() => this.update(), 1000);
    },

    update() {
      const now = new Date();
      const options: Intl.DateTimeFormatOptions = {
        timeZone: 'Europe/Madrid',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
      };

      const timeString = now.toLocaleTimeString('es-ES', options);
      const [hours, minutes] = timeString.split(':');

      const newValues = {
        h1: hours[0],
        h2: hours[1],
        m1: minutes[0],
        m2: minutes[1],
      };

      // Actualizar cada dígito con animación flip si cambió
      Object.keys(newValues).forEach(key => {
        const digit = document.querySelector(`[data-digit="${key}"]`);
        const inner = digit?.querySelector('.flip-digit__inner') as HTMLElement;

        if (
          inner &&
          this.lastValues[key as keyof typeof this.lastValues] !==
            newValues[key as keyof typeof newValues]
        ) {
          digit?.classList.add('is-flipping');
          inner.textContent = newValues[key as keyof typeof newValues];

          setTimeout(() => {
            digit?.classList.remove('is-flipping');
          }, 400);
        }
      });

      this.lastValues = newValues;

      // Actualizar zona horaria
      const timezoneElement = document.querySelector('.footer-timezone');
      if (timezoneElement) {
        const madridTime = new Date().toLocaleString('en-US', {
          timeZone: 'Europe/Madrid',
          timeZoneName: 'short',
        });
        const isCEST = madridTime.includes('+2') || madridTime.includes('CEST');
        timezoneElement.textContent = isCEST ? 'CEST' : 'CET';
      }
    },
  };

  document.addEventListener('DOMContentLoaded', () => flipClock.init());
</script>
