---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="footer-main">
    <!-- Ubicación + Hora local -->
    <div class="footer-location-time">
      <span class="footer-location">Santander, ES</span>
      <span class="footer-time-separator">·</span>
      <span class="footer-time" id="footer-local-time">--:--</span>
      <span class="footer-timezone">CET</span>
    </div>

    <!-- Navegación rediseñada - estilo técnico con índices -->
    <nav class="footer-nav" aria-label={t('footer.nav.aria')}>
      <ul class="footer-nav-list">
        <li>
          <span class="nav-index">01</span>
          <a href="#projects">{t('nav.projects')}</a>
        </li>
        <li>
          <span class="nav-index">02</span>
          <a href="#journey">{t('nav.journey')}</a>
        </li>
        <li>
          <span class="nav-index">03</span>
          <a href="#technologies">{t('nav.technologies')}</a>
        </li>
      </ul>
    </nav>
  </div>

  <!-- Línea discontinua -->
  <div class="footer-divider"></div>

  <!-- Firma y metadata -->
  <div class="footer-bottom">
    <span class="footer-signature">
      {t('footer.signature')}
      <strong>Álvaro Lostal</strong>
    </span>
    <span class="footer-version">{t('footer.version')} · {currentYear}</span>
  </div>
</footer>

<style>
  /* Footer Grid Editorial - Estilo técnico */
  footer {
    background: var(--bg-primary);
    border-top: 1px solid var(--border);
    padding: 64px 24px 48px;
  }

  .footer-main {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 48px;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .footer-main {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 48px;
    }
  }

  /* Ubicación + Hora local */
  .footer-location-time {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.3px;
    color: var(--text-tertiary);
  }

  .footer-location {
    color: var(--text-secondary);
  }

  .footer-time-separator {
    opacity: 0.4;
  }

  .footer-time {
    font-variant-numeric: tabular-nums;
    min-width: 40px;
  }

  .footer-timezone {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    opacity: 0.6;
  }

  /* Navegación con índices - estilo técnico/editorial */
  .footer-nav {
    display: flex;
    align-items: center;
  }

  .footer-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 32px;
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 480px) {
    .footer-nav-list {
      gap: 24px;
    }
  }

  .footer-nav-list li {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .nav-index {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-tertiary);
    letter-spacing: 0.5px;
    opacity: 0.6;
  }

  .footer-nav-list a {
    font-size: 14px;
    color: var(--text-secondary);
    text-decoration: none;
    letter-spacing: 0.2px;
    transition: color 0.2s ease;
    position: relative;
  }

  .footer-nav-list a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--text-primary);
    transition: width 0.2s ease;
  }

  @media (hover: hover) {
    .footer-nav-list a:hover {
      color: var(--text-primary);
    }

    .footer-nav-list a:hover::after {
      width: 100%;
    }

    .footer-nav-list li:hover .nav-index {
      opacity: 1;
    }
  }

  /* Línea discontinua */
  .footer-divider {
    max-width: 1200px;
    margin: 48px auto;
    height: 1px;
    background: repeating-linear-gradient(
      to right,
      var(--border) 0,
      var(--border) 8px,
      transparent 8px,
      transparent 16px
    );
  }

  /* Footer Bottom */
  .footer-bottom {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  @media (max-width: 768px) {
    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }
  }

  .footer-signature {
    font-size: 13px;
    color: var(--text-tertiary);
    letter-spacing: 0.2px;
  }

  .footer-signature strong {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .footer-version {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-tertiary);
    letter-spacing: 0.5px;
    opacity: 0.7;
  }
</style>

<script>
  // Reloj en tiempo real - Hora local de Santander (Europe/Madrid)
  function updateFooterClock(): void {
    const timeElement = document.getElementById('footer-local-time');
    const timezoneElement = document.querySelector('.footer-timezone');
    if (!timeElement) return;

    const now = new Date();
    const options: Intl.DateTimeFormatOptions = {
      timeZone: 'Europe/Madrid',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    };

    const timeString = now.toLocaleTimeString('es-ES', options);
    timeElement.textContent = timeString;

    // Detectar CET o CEST (horario de verano)
    if (timezoneElement) {
      const madridTime = new Date().toLocaleString('en-US', {
        timeZone: 'Europe/Madrid',
        timeZoneName: 'short',
      });
      // En verano incluye "+2" o "CEST", en invierno "+1" o "CET"
      const isCEST = madridTime.includes('+2') || madridTime.includes('CEST');
      timezoneElement.textContent = isCEST ? 'CEST' : 'CET';
    }
  }

  // Actualizar inmediatamente y cada segundo
  updateFooterClock();
  setInterval(updateFooterClock, 1000);
</script>
