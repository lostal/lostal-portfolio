---
import { useTranslations, getLocalizedPath } from '../i18n/utils';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<nav id="navbar">
  <div class="container">
    <div class="nav-content">
      <a href="#top" class="logo" aria-label={t('nav.home')}>AL</a>

      <ul class="nav-links">
        <li><a href="#projects">{t('nav.projects')}</a></li>
        <li><a href="#journey">{t('nav.journey')}</a></li>
        <li><a href="#technologies">{t('nav.technologies')}</a></li>
        <li><a href="#contact">{t('nav.contact')}</a></li>
      </ul>

      <div class="nav-actions">
        <!-- Language menu: emoji/flag-only button that shows a mini popover on hover/click -->
        <div class="lang-menu">
          <a
            href={getLocalizedPath('/', lang === 'es' ? 'en' : 'es')}
            class="lang-btn"
            id="langBtn"
            data-lang={lang}
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="langPopover"
            aria-label={lang === 'es' ? 'Idioma: Español' : 'Language: English'}
            title={lang === 'es' ? 'Español' : 'English'}
          >
            <i class="fas fa-language" id="langIcon" aria-hidden="true"></i>
          </a>

          <ul
            class="lang-popover"
            id="langPopover"
            role="menu"
            aria-labelledby="langBtn"
          >
            <li class="lang-item" role="menuitem">
              <a href="/" class="lang-action" data-lang="es">
                <img src="/assets/flags/es.svg" alt="" width="26" height="26" />
                <span class="lang-label">Español</span>
              </a>
            </li>
            <li class="lang-item" role="menuitem">
              <a href="/en/" class="lang-action" data-lang="en">
                <img src="/assets/flags/us.svg" alt="" width="26" height="26" />
                <span class="lang-label">English</span>
              </a>
            </li>
          </ul>
        </div>

        <theme-toggle>
          <button
            class="theme-toggle"
            id="themeToggle"
            aria-label={t('nav.theme')}
          >
            <i class="fas fa-lightbulb" id="themeIcon"></i>
          </button>
        </theme-toggle>
        <button
          class="mobile-menu-btn"
          id="mobileMenuBtn"
          aria-label={t('nav.menu')}
        >
          <div class="hamburger-icon">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
          </div>
        </button>
      </div>
    </div>
  </div>

  <div class="mobile-menu" id="mobileMenu">
    <ul class="mobile-menu-links">
      <li>
        <a href="#projects" class="mobile-link">{t('nav.projects')}</a>
      </li>
      <li>
        <a href="#journey" class="mobile-link">{t('nav.journey')}</a>
      </li>
      <li>
        <a href="#technologies" class="mobile-link">{t('nav.technologies')}</a>
      </li>
      <li>
        <a href="#contact" class="mobile-link">{t('nav.contact')}</a>
      </li>
    </ul>
  </div>
</nav>

<style>
  /* Navigation */
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-navigation);
    background: rgba(var(--bg-primary-rgb), 0.5);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    transition: all var(--animation-duration) ease;
  }

  :global([data-theme='dark']) nav {
    background: rgba(var(--bg-primary-rgb), 0.5);
  }

  nav.scrolled {
    box-shadow: 0 2px 12px var(--shadow);
  }

  .nav-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: var(--nav-height);
    position: relative;
  }

  .logo {
    font-size: var(--font-size-2xl);
    font-weight: 800;
    color: var(--accent-primary);
    text-decoration: none;
    transition: all var(--animation-duration) ease;
    letter-spacing: -1px;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      'Roboto',
      'Helvetica Neue',
      Arial,
      sans-serif;
    background: linear-gradient(
      135deg,
      var(--accent-primary),
      var(--accent-dark)
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    position: relative;
    text-transform: uppercase;
  }

  .logo::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 0;
    width: 100%;
    height: 3.5px;
    background: var(--accent-primary);
    transition: transform var(--animation-duration) cubic-bezier(0.4, 0, 0.2, 1);
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* Hover siempre activo (incluido móvil) */
  .logo:hover::after {
    transform: scaleX(1);
  }

  /* Active state for logo (hero section) - desktop only */
  @media (min-width: 768px) {
    .logo.active::after {
      transform: scaleX(1);
    }

    /* Direction-aware animations for logo */
    .logo.scroll-down::after {
      transform-origin: left center;
    }

    .logo.scroll-up::after {
      transform-origin: right center;
    }

    /* Exiting animation - opposite direction for logo */
    .logo.scroll-down:not(.active)::after {
      transform-origin: right center;
    }

    .logo.scroll-up:not(.active)::after {
      transform-origin: left center;
    }
  }

  .nav-links {
    display: none;
    gap: 32px;
    list-style: none;
  }

  @media (min-width: 768px) {
    .nav-links {
      display: flex;
    }
  }

  .nav-links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    transition: color var(--animation-duration) ease;
    position: relative;
  }

  @media (hover: hover) {
    .nav-links a:hover {
      color: var(--text-primary);
    }

    .nav-links a:hover::after {
      transform: scaleX(1);
    }
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transition: transform var(--animation-duration) cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: left center;
  }

  /* Active state for nav links - desktop only */
  @media (min-width: 768px) {
    .nav-links a.active {
      color: var(--text-primary);
    }

    .nav-links a.active::after {
      transform: scaleX(1);
    }

    /* Direction-aware animations */
    .nav-links a.scroll-down::after {
      transform-origin: left center;
    }

    .nav-links a.scroll-up::after {
      transform-origin: right center;
    }

    /* Exiting animation - opposite direction */
    .nav-links a.scroll-down:not(.active)::after {
      transform-origin: right center;
    }

    .nav-links a.scroll-up:not(.active)::after {
      transform-origin: left center;
    }
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  /* Language mini-menu: emoji-only button + popover */
  .lang-menu {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .lang-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 10px;
    color: var(--text-secondary);
    font-size: 22px;
    transition: all var(--animation-duration) ease;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    -webkit-tap-highlight-color: transparent;
    text-decoration: none;
  }

  @media (hover: hover) {
    .lang-btn:hover {
      background: var(--bg-secondary);
      color: var(--accent-primary);
    }
  }

  .lang-btn:focus {
    outline: none;
  }

  .lang-btn:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  .lang-btn:active {
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* Animación de click elegante para el icono de idioma */
  @keyframes lang-click-bounce-icon {
    0% {
      transform: translateY(0) scale(1) rotate(0deg);
      opacity: 1;
    }

    20% {
      transform: translateY(-2px) scale(1.15) rotate(-8deg);
      opacity: 0.9;
    }

    40% {
      transform: translateY(0) scale(1.1) rotate(5deg);
      opacity: 1;
    }

    60% {
      transform: translateY(-1px) scale(1.05) rotate(-3deg);
    }

    80% {
      transform: translateY(0) scale(1.02) rotate(1deg);
    }

    100% {
      transform: translateY(0) scale(1) rotate(0deg);
    }
  }

  /* Efecto de feedback visual al hacer click */
  #langIcon.clicked,
  .lang-btn i.clicked {
    animation: lang-click-bounce-icon 650ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Efecto visual adicional para el botón durante la transición */
  .lang-btn.transitioning {
    pointer-events: none;
  }

  .lang-btn.transitioning i {
    color: var(--accent-primary);
  }

  /* Visual hint according to selected language (subtle) */
  /* Remove permanent language-based coloring — keep neutral color and only
   accent on hover/focus so the icon doesn't look "selected" all the time. */

  .lang-popover {
    position: absolute;
    /* keep normal visual spacing; we'll provide an invisible bridge to capture pointer
     so slow mouse moves between button and popover don't close it */
    top: calc(100% + 8px);
    right: 0;
    min-width: 168px;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 8px;
    box-shadow: 0 8px 30px var(--shadow-md);
    list-style: none;
    margin: 0;
    opacity: 0;
    transform: translateY(-6px) scale(0.98);
    pointer-events: none;
    transition:
      opacity var(--animation-duration) ease,
      transform var(--animation-duration) cubic-bezier(0.22, 1, 0.36, 1);
    z-index: var(--z-nav-popover);
  }

  .lang-item {
    padding: 8px 10px;
  }

  .lang-item > a {
    width: 100%;
    display: flex;
    gap: 10px;
    align-items: center;
    background: transparent;
    border: none;
    padding: 8px 10px;
    border-radius: var(--radius-md);
    cursor: pointer;
    color: var(--text-primary);
    font-size: 16px;
    text-decoration: none;
  }

  .lang-item > a img {
    width: 26px;
    height: 26px;
    border-radius: var(--radius-sm);
  }

  .lang-item > a:focus {
    background: var(--bg-secondary);
    outline: none;
  }

  @media (hover: hover) {
    .lang-item > a:hover {
      background: var(--bg-secondary);
    }
  }

  /* Selected language in the popover: slightly bolder label to highlight */
  .lang-popover a.selected .lang-label {
    font-weight: 600;
  }

  /* Show menu when opened via keyboard navigation (class added by JS) */
  .lang-menu.open .lang-popover {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .lang-menu.open .lang-popover::before {
    pointer-events: auto;
  }

  /* Only allow the hover reveal on devices that support hover/pointer precision
   (desktop / non-touch). On touch devices we'll keep popover hidden and let JS
   handle a direct language toggle. The menu will close when mouse leaves. */
  @media (hover: hover) and (pointer: fine) {
    .lang-menu[data-ready='1']:hover .lang-popover {
      opacity: 1;
      transform: translateY(0) scale(1);
      pointer-events: auto;
    }

    .lang-menu[data-ready='1']:hover .lang-popover::before {
      pointer-events: auto;
    }
  }

  /* Invisible bridge to avoid the pointer dead zone between the button and the popover.
   It's enabled only when the popover is visible (hover/focus/open). */
  .lang-popover::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -12px;
    /* span the gap between button and popover */
    height: 12px;
    pointer-events: none;
  }

  .lang-menu[data-ready='1']:hover .lang-popover::before,
  .lang-menu.open .lang-popover::before {
    pointer-events: auto;
  }

  @media (min-width: 768px) {
    .lang-popover {
      right: 0;
      min-width: 160px;
    }

    /* Center the nav links horizontally within the nav (independent of action buttons width) */
    .nav-links {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      z-index: 5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-btn,
    .lang-popover,
    .logo,
    .nav-links a::after {
      transition: none !important;
    }
  }

  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    padding: 10px;
    color: var(--text-secondary);
    font-size: 22px;
    transition: all var(--animation-duration) ease;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    -webkit-tap-highlight-color: transparent;
  }

  @media (hover: hover) {
    .theme-toggle:hover {
      background: var(--bg-secondary);
      color: var(--accent-primary);
    }
  }

  .theme-toggle:focus {
    outline: none;
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  .theme-toggle:active {
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* Mobile Menu */
  .mobile-menu-btn {
    display: block;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-secondary);
    padding: 10px;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--animation-duration) ease;
    border-radius: var(--radius-md);
  }

  @media (hover: hover) {
    .mobile-menu-btn:hover {
      background: var(--bg-secondary);
      transform: scale(1.05);
    }

    .mobile-menu-btn:hover .hamburger-line {
      background: var(--accent-primary);
    }

    .mobile-menu-btn.active:hover .hamburger-line {
      background: var(--accent-primary);
    }
  }

  .mobile-menu-btn:active {
    transform: scale(0.95);
  }

  .mobile-menu-btn.active {
    background: var(--bg-secondary);
    border-bottom: 2px solid var(--accent-primary);
    border-radius: 8px 8px 0 0;
  }

  /* Hamburger Icon Animation */
  .hamburger-icon {
    width: 24px;
    height: 20px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hamburger-line {
    width: 100%;
    height: 2px;
    background: var(--text-secondary);
    border-radius: var(--radius-xs);
    transition: all var(--animation-duration)
      cubic-bezier(0.25, 0.46, 0.45, 0.94);
    transform-origin: center;
  }

  /* Animation when menu is active */
  .mobile-menu-btn.active .hamburger-line:nth-child(1) {
    transform: translateY(9px) rotate(45deg);
  }

  .mobile-menu-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .mobile-menu-btn.active .hamburger-line:nth-child(3) {
    transform: translateY(-9px) rotate(-45deg);
  }

  @media (min-width: 768px) {
    .mobile-menu-btn {
      display: none;
    }
  }

  .mobile-menu {
    position: fixed;
    top: var(--nav-height);
    left: 0;
    right: 0;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border);
    padding: 0 20px;
    transform-origin: top center;
    transform: scaleY(0);
    opacity: 0;
    visibility: hidden;
    transition: all var(--animation-duration)
      cubic-bezier(0.25, 0.46, 0.45, 0.94);
    max-height: calc(100vh - var(--nav-height));
    overflow: hidden;
    box-shadow: 0 4px 20px var(--shadow);
  }

  .mobile-menu::before {
    content: '';
    position: absolute;
    top: -1px;
    right: 20px;
    width: 40px;
    height: 1px;
    background: var(--accent-primary);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--animation-duration)
      cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.1s;
  }

  .mobile-menu.active {
    transform: scaleY(1);
    opacity: 1;
    visibility: visible;
    padding: 20px;
    overflow-y: auto;
  }

  .mobile-menu.active::before {
    transform: scaleX(1);
  }

  .mobile-menu-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mobile-menu-links li {
    transform: translateY(-20px);
    opacity: 0;
    transition: all var(--animation-duration)
      cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .mobile-menu.active .mobile-menu-links li {
    transform: translateY(0);
    opacity: 1;
  }

  .mobile-menu.active .mobile-menu-links li:nth-child(1) {
    transition-delay: 0.1s;
  }

  .mobile-menu.active .mobile-menu-links li:nth-child(2) {
    transition-delay: 0.15s;
  }

  .mobile-menu.active .mobile-menu-links li:nth-child(3) {
    transition-delay: 0.2s;
  }

  .mobile-menu.active .mobile-menu-links li:nth-child(4) {
    transition-delay: 0.25s;
  }

  .mobile-menu.active .mobile-menu-links li:nth-child(5) {
    transition-delay: 0.3s;
  }

  .mobile-menu-links a {
    color: var(--text-primary);
    text-decoration: none;
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    display: block;
    padding: 12px 0;
    transition: all var(--animation-duration) ease;
    position: relative;
  }

  @media (hover: hover) {
    .mobile-menu-links a:hover {
      color: var(--accent-primary);
      transform: translateX(8px);
    }
  }
</style>
