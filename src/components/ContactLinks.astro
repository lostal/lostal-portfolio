---

<div class="contact-pill">
  <button
    type="button"
    class="contact-link copy-email-btn"
    data-contact="email"
    data-email="alvaro@lostal.dev"
  >
    <i class="fas fa-envelope" aria-hidden="true"></i>
    <span class="sr-only">Email</span>
  </button>

  <a
    href="https://github.com/lostal"
    target="_blank"
    rel="noopener noreferrer"
    class="contact-link"
    data-contact="github"
  >
    <i class="fab fa-github" aria-hidden="true"></i>
    <span class="sr-only">GitHub</span>
  </a>

  <a
    href="https://linkedin.com/in/alvarolostal"
    target="_blank"
    rel="noopener noreferrer"
    class="contact-link"
    data-contact="linkedin"
  >
    <i class="fab fa-linkedin" aria-hidden="true"></i>
    <span class="sr-only">LinkedIn</span>
  </a>
</div>

<style>
  /* Contenedor píldora con glassmorphism */
  .contact-pill {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 20px;
    background: rgba(var(--bg-primary-rgb), 0.95);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(var(--border-rgb, 229, 231, 235), 0.3);
    border-radius: 36px;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.12),
      0 2px 16px rgba(0, 0, 0, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  /* Tema oscuro */
  :global([data-theme='dark']) .contact-pill {
    background: rgba(var(--bg-primary-rgb), 0.95);
    border: 1px solid rgba(var(--border-rgb, 66, 66, 69), 0.5);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.4),
      0 2px 16px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  /* Enlaces de contacto */
  .contact-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--bg-secondary);
    border-radius: 24px;
    color: var(--text-primary);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
    transition: all var(--animation-duration) ease;
    border: 1px solid var(--border);
    font-size: var(--font-size-xl);
  }

  @media (hover: hover) {
    .contact-link:hover {
      background: var(--accent-primary);
      color: var(--text-on-accent);
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(var(--accent-primary-rgb), 0.3);
      border-color: var(--accent-primary);
    }
  }

  /* Cursor pointer para el botón de email */
  button.contact-link {
    cursor: pointer;
  }

  /* Screen reader only - texto accesible oculto visualmente */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
