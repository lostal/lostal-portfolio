---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="journey" class="section-alt">
  <div class="container">
    <div class="section-header fade-in">
      <div class="section-divider divider-loading"></div>
      <h2 class="section-title">{t('journey.title')}</h2>
      <p class="section-description">
        {t('journey.description')}
      </p>
    </div>

    <div class="experience-grid">
      <div class="experience-column" aria-labelledby="exp-title">
        <div class="column-header">
          <h2 id="exp-title" class="column-title">
            {t('journey.experience')}
          </h2>
          <div class="column-divider"></div>
        </div>

        <div class="timeline">
          <article
            class="timeline-item card fade-in"
            aria-roledescription="entry"
          >
            <div class="card-inner">
              <div class="timeline-logo" aria-hidden="true">
                <img
                  src="/assets/logos/eurocastalia.svg"
                  alt="Logo de Eurocastalia, empresa donde realicé prácticas de desarrollo web"
                  width="50"
                  height="50"
                />
              </div>

              <div class="timeline-body">
                <div class="timeline-header">
                  <h3 class="timeline-title">
                    {t('journey.eurocastalia.title')}
                  </h3>
                  <span class="timeline-date"
                    >{t('journey.eurocastalia.date')}</span
                  >
                </div>
                <div class="timeline-subtitle">
                  {t('journey.eurocastalia.company')}
                </div>
                <p class="timeline-description">
                  {t('journey.eurocastalia.description')}
                </p>
                <ul class="timeline-list">
                  <li>{t('journey.eurocastalia.task1')}</li>
                  <li>{t('journey.eurocastalia.task2')}</li>
                </ul>
              </div>
            </div>
          </article>
        </div>
      </div>

      <div class="experience-column" aria-labelledby="edu-title">
        <div class="column-header">
          <h2 id="edu-title" class="column-title">
            {t('journey.education')}
          </h2>
          <div class="column-divider"></div>
        </div>

        <div class="timeline">
          <article
            class="timeline-item card fade-in"
            aria-roledescription="education"
          >
            <div class="card-inner">
              <div class="timeline-logo" aria-hidden="true">
                <img
                  src="/assets/logos/uea.svg"
                  alt="Logo de la Universidad Europea del Atlántico donde estudio Ingeniería Informática"
                  width="50"
                  height="50"
                />
              </div>

              <div class="timeline-body">
                <div class="timeline-header">
                  <h3 class="timeline-title">
                    {t('journey.uea.title')}
                  </h3>
                  <span class="timeline-date">{t('journey.uea.date')}</span>
                </div>
                <div class="timeline-subtitle">
                  {t('journey.uea.institution')}
                </div>
                <p class="timeline-description">
                  {t('journey.uea.description')}
                </p>
                <ul class="timeline-list">
                  <li>{t('journey.uea.subject1')}</li>
                  <li>{t('journey.uea.subject2')}</li>
                  <li>{t('journey.uea.subject3')}</li>
                </ul>
              </div>
            </div>
          </article>

          <article
            class="timeline-item card fade-in"
            aria-roledescription="certification"
          >
            <div class="card-inner">
              <div class="timeline-logo" aria-hidden="true">
                <img
                  src="/assets/logos/cambridge.svg"
                  alt="Logo de Cambridge Assessment English donde obtuve mi certificación B2 First"
                  width="50"
                  height="50"
                />
              </div>

              <div class="timeline-body">
                <div class="timeline-header">
                  <h3 class="timeline-title">
                    {t('journey.cambridge.title')}
                  </h3>
                  <span class="timeline-date"
                    >{t('journey.cambridge.date')}</span
                  >
                </div>
                <div class="timeline-subtitle">
                  {t('journey.cambridge.institution')}
                </div>
                <p class="timeline-description">
                  {t('journey.cambridge.description')}
                </p>
              </div>
            </div>
          </article>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Journey: Loading circular | → / → - → \ → | */
  .divider-loading::before {
    content: '|';
    animation: loading-spin 1s step-end infinite;
  }

  @keyframes loading-spin {
    0%,
    12.5% {
      content: '|';
    }

    12.5%,
    25% {
      content: '/';
    }

    25%,
    37.5% {
      content: '—';
    }

    37.5%,
    50% {
      content: '\\';
    }

    50%,
    62.5% {
      content: '|';
    }

    62.5%,
    75% {
      content: '/';
    }

    75%,
    87.5% {
      content: '—';
    }

    87.5%,
    100% {
      content: '\\';
    }
  }

  /* Journey Section */
  .experience-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 60px;
    max-width: 1000px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .experience-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .experience-column {
    width: 100%;
  }

  .column-header {
    margin-bottom: 40px;
    text-align: center;
  }

  .column-title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
    margin-bottom: 6px;
  }

  .column-divider {
    height: 2px;
    width: 40px;
    background: var(--accent-primary);
    margin: 0 auto;
  }

  .timeline {
    max-width: 700px;
    margin: 0 auto;
  }

  .timeline-item {
    position: relative;
    margin-bottom: 20px;
    animation: fadeInUp var(--animation-duration-slow) ease-out;
  }

  .timeline-item::before {
    content: '';
    display: none;
  }

  .timeline-item:last-child::after {
    display: none;
  }

  .card {
    background: var(--bg-secondary);
    padding: 20px 22px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    transition: all var(--animation-duration) ease;
  }

  /* Modo claro: en secciones con fondo --bg-secondary, las cards intercalan a --bg-primary */
  :global([data-theme='light']) .section-alt .card,
  :global([data-theme='light']) :global(.section-alt) .card {
    background: var(--bg-primary);
  }

  @media (hover: hover) {
    .card:hover {
      border-color: var(--accent-primary);
      box-shadow: var(--shadow-sm);
    }
  }

  .card-inner {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 18px;
    align-items: start;
    padding-left: 0;
  }

  .timeline-logo {
    position: relative;
    width: 50px;
    height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    overflow: hidden;
    flex: 0 0 auto;
  }

  .timeline-logo img,
  .timeline-logo svg {
    /* Fill the wrapper and keep aspect ratio; object-fit ensures the logo scales up to occupy space
       without distortion. This helps SVGs whose artwork doesn't fill their internal viewBox. */
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .timeline-body {
    min-width: 0;
  }

  .timeline-header {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    margin-bottom: 8px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .timeline-header .timeline-title {
    flex: 1 1 auto;
    min-width: 0;
  }

  .timeline-header .timeline-date {
    flex: 0 0 auto;
    display: inline-block;
    margin-left: 0;
    text-align: left;
  }

  .timeline-title {
    font-size: 17px;
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
  }

  .timeline-date {
    font-size: var(--font-size-xs);
    font-family: var(--font-mono);
    color: var(--text-tertiary);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .timeline-subtitle {
    font-size: var(--font-size-sm);
    color: var(--accent-primary);
    margin-bottom: 8px;
    font-weight: var(--font-weight-medium);
  }

  .timeline-description {
    color: var(--text-secondary);
    line-height: 1.6;
    font-size: 15px;
  }

  .timeline-list {
    list-style: none;
    margin-top: 10px;
  }

  .timeline-list li {
    color: var(--text-secondary);
    padding-left: 16px;
    position: relative;
    margin-bottom: 6px;
    font-size: var(--font-size-sm);
  }

  .timeline-list li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--accent-primary);
    font-weight: bold;
  }

  @media (max-width: 768px) {
    .timeline-item::before {
      display: none;
    }

    .timeline {
      padding-left: 0;
    }

    .card {
      padding-left: 14px;
    }

    .timeline-logo {
      margin-left: 6px;
    }

    .card-inner {
      grid-template-columns: 1fr;
      text-align: left;
      gap: 10px;
    }

    .timeline-logo {
      margin: 0 auto 4px;
      width: 44px;
      height: 44px;
    }

    .timeline-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }
  }

  @media (max-width: 768px) {
    .experience-grid {
      gap: 40px;
    }

    .column-header {
      margin-bottom: 28px;
    }
  }

  @media (max-width: 600px) {
    .card {
      padding: 18px;
      border-radius: var(--radius-lg);
    }

    .timeline {
      max-width: 100%;
      margin: 0 auto;
    }

    .experience-grid {
      gap: 32px;
    }

    .column-header {
      margin-bottom: 24px;
    }
  }
</style>
