---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contact" class="section-alt">
  <div class="container">
    <div class="section-header fade-in">
      <div class="section-divider divider-typing-dots"></div>
      <h2 class="section-title">{t('contact.title')}</h2>
      <p class="section-description">
        {t('contact.description')}
      </p>
    </div>

    <div class="contact-content fade-in">
      <div class="contact-links" id="main-contact-links">
        <a
          href="mailto:alvarolostal04@gmail.com"
          class="contact-link"
          title="Email"
          data-contact="email"
        >
          <i class="fas fa-envelope"></i>
        </a>

        <a
          href="https://github.com/lostal"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-link"
          title="GitHub"
          data-contact="github"
        >
          <i class="fab fa-github"></i>
        </a>

        <a
          href="https://linkedin.com/in/alvarolostal"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-link"
          title="LinkedIn"
          data-contact="linkedin"
        >
          <i class="fab fa-linkedin"></i>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Contact: Typing dots */
  .divider-typing-dots {
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    letter-spacing: 2px;
  }

  .divider-typing-dots::before {
    content: '.';
    animation: typing-dots 1.5s step-end infinite;
  }

  @keyframes typing-dots {
    0%,
    33% {
      content: '.';
    }

    33%,
    66% {
      content: '..';
    }

    66%,
    100% {
      content: '...';
    }
  }

  /* Contact Section */
  .contact-content {
    max-width: 500px;
    margin: 0 auto;
    text-align: center;
  }

  .contact-links {
    display: flex;
    justify-content: center;
    gap: 14px;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--bg-secondary);
    border-radius: 24px;
    /* Border radius circular para consonancia con el widget */
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
    border: 1px solid var(--border);
    font-size: 20px;
  }

  @media (hover: hover) {
    .contact-link:hover {
      background: var(--accent-primary);
      color: #000;
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(var(--accent-primary-rgb), 0.3);
      border-color: var(--accent-primary);
    }
  }
</style>
