---
import { useTranslations } from '../i18n/utils';
import ContactLinks from './ContactLinks.astro';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="contact" class="section-alt">
  <div class="container">
    <div class="section-header fade-in">
      <div class="section-divider divider-typing-dots"></div>
      <h2 class="section-title">{t('contact.title')}</h2>
      <p class="section-description">
        {t('contact.description')}
      </p>
    </div>

    <!-- Punto de anclaje para el widget flotante (desktop) -->
    <div class="contact-dock-wrapper">
      <div id="contact-dock-point" class="contact-dock-point"></div>
    </div>

    <!-- Enlaces de contacto estáticos (móvil) -->
    <div class="contact-mobile fade-in">
      <ContactLinks />
    </div>
  </div>
</section>

<style>
  /* Contact: Typing dots */
  .divider-typing-dots {
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    letter-spacing: 2px;
  }

  .divider-typing-dots::before {
    content: '.';
    animation: typing-dots 1.5s step-end infinite;
  }

  @keyframes typing-dots {
    0%,
    33% {
      content: '.';
    }

    33%,
    66% {
      content: '..';
    }

    66%,
    100% {
      content: '...';
    }
  }

  /* Contact dock wrapper */
  .contact-dock-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 32px;
    position: relative;
  }

  /* Punto de anclaje para el widget flotante */
  .contact-dock-point {
    position: relative;
    min-height: 72px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Ocultar dock point en móviles */
  @media (max-width: 768px), (orientation: portrait), (pointer: coarse) {
    .contact-dock-point {
      display: none;
    }
  }

  /* Enlaces estáticos para móvil */
  .contact-mobile {
    display: none;
    justify-content: center;
    margin-top: 32px;
  }

  @media (max-width: 768px), (orientation: portrait), (pointer: coarse) {
    .contact-mobile {
      display: flex;
    }
  }
</style>
