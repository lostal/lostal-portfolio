---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="technologies">
  <div class="container">
    <div class="section-header fade-in">
      <div class="section-divider divider-terminal"></div>
      <h2 class="section-title">
        {t('technologies.title')}
      </h2>
      <p class="section-description">
        {t('technologies.description')}
      </p>
    </div>

    <div class="technologies-grid">
      <div class="technology-card fade-in">
        <i class="fas fa-code technology-icon"></i>
        <h3 class="technology-title">{t('technologies.languages')}</h3>
        <div class="technology-tags">
          <span class="tag">
            <img
              src="/assets/tech-icons/javascript.svg"
              alt="JavaScript"
              class="tech-mini-icon"
              loading="lazy"
            />
            JavaScript
          </span>
          <span class="tag">
            <img
              src="/assets/tech-icons/typescript.svg"
              alt="TypeScript"
              class="tech-mini-icon"
              loading="lazy"
            />
            TypeScript
          </span>
          <span class="tag">
            <img
              src="/assets/tech-icons/html5.svg"
              alt="HTML5"
              class="tech-mini-icon"
              loading="lazy"
            />
            HTML5
          </span>
          <span class="tag">
            <img
              src="/assets/tech-icons/css3.svg"
              alt="CSS3"
              class="tech-mini-icon"
              loading="lazy"
            />
            CSS3
          </span>
          <span class="tag">
            <img
              src="/assets/tech-icons/tailwind.svg"
              alt="Tailwind CSS"
              class="tech-mini-icon"
              loading="lazy"
            />
            Tailwind CSS
          </span>
        </div>
      </div>

      <div class="technology-card fade-in">
        <i class="fas fa-cubes technology-icon"></i>
        <h3 class="technology-title">{t('technologies.frameworks')}</h3>
        <div class="technology-tags">
          <span class="tag">
            <img
              src="/assets/tech-icons/react.svg"
              alt="React"
              class="tech-mini-icon"
              loading="lazy"
            />
            React.js
          </span>
          <span class="tag">
            <img
              src="/assets/tech-icons/nextjs.svg"
              alt="Next.js"
              class="tech-mini-icon"
              loading="lazy"
            />
            Next.js
          </span>
          <span class="tag">
            <img
              src="/assets/tech-icons/astro.svg"
              alt="Astro"
              class="tech-mini-icon"
              loading="lazy"
            />
            Astro
          </span>
          <span class="tag">
            <img
              src="/assets/tech-icons/nodejs.svg"
              alt="Node.js"
              class="tech-mini-icon"
              loading="lazy"
            />
            Node.js
          </span>
          <span class="tag">
            <img
              src="/assets/tech-icons/mongodb.svg"
              alt="MongoDB"
              class="tech-mini-icon"
              loading="lazy"
            />
            MongoDB
          </span>
        </div>
      </div>

      <div class="technology-card fade-in">
        <i class="fas fa-tools technology-icon"></i>
        <h3 class="technology-title">{t('technologies.tools')}</h3>
        <div class="technology-tags">
          <span class="tag">
            <img
              src="/assets/tech-icons/vscode.svg"
              alt="VS Code"
              class="tech-mini-icon"
              loading="lazy"
            />
            VS Code
          </span>
          <span class="tag">
            <img
              src="/assets/tech-icons/figma.svg"
              alt="Figma"
              class="tech-mini-icon"
              loading="lazy"
            />
            Figma
          </span>
          <span class="tag">
            <img
              src="/assets/tech-icons/github.svg"
              alt="GitHub"
              class="tech-mini-icon"
              loading="lazy"
            />
            GitHub
          </span>
          <span class="tag">
            <img
              src="/assets/tech-icons/photoshop.svg"
              alt="Photoshop"
              class="tech-mini-icon"
              loading="lazy"
            />
            Photoshop
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Technologies: Prompt >_ */
  .divider-terminal::before {
    content: '>';
  }

  .divider-terminal::after {
    content: '_';
    animation: terminal-cursor 1s step-end infinite;
  }

  @keyframes terminal-cursor {
    0%,
    50% {
      opacity: 1;
    }

    50%,
    100% {
      opacity: 0;
    }
  }

  /* Technologies Section */
  .technologies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .technology-card {
    background: var(--bg-secondary);
    padding: 28px;
    border-radius: 12px;
    transition: all 0.2s ease;
    animation: fadeInUp 0.8s ease-out;
    border: 1px solid var(--border);
  }

  @media (hover: hover) {
    .technology-card:hover {
      border-color: var(--accent-primary);
    }
  }

  .technology-icon {
    font-size: 28px;
    margin-bottom: 14px;
    display: block;
    color: var(--accent-primary);
  }

  .technology-title {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 12px;
    color: var(--text-primary);
  }

  .technology-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }
</style>
