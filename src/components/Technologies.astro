---
import { useTranslations, type TranslationKey } from '../i18n/utils';
import { technologies } from '../data';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="technologies">
  <div class="container">
    <div class="section-header fade-in">
      <div class="section-divider divider-terminal"></div>
      <h2 class="section-title">
        {t('technologies.title')}
      </h2>
      <p class="section-description">
        {t('technologies.description')}
      </p>
    </div>

    <div class="technologies-grid">
      {
        technologies.map(category => (
          <div class="technology-card fade-in">
            <i class={`${category.iconClass} technology-icon`} />
            <h3 class="technology-title">
              {t(`technologies.${category.id}` as TranslationKey)}
            </h3>
            <div class="technology-tags">
              {category.items.map(tech => (
                <span class="tag">
                  <img
                    src={tech.icon}
                    alt={tech.name}
                    class="tech-mini-icon"
                    width="14"
                    height="14"
                    loading="lazy"
                  />
                  {tech.name}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Technologies: Prompt >_ */
  .divider-terminal::before {
    content: '>';
  }

  .divider-terminal::after {
    content: '_';
    animation: terminal-cursor 1s step-end infinite;
  }

  @keyframes terminal-cursor {
    0%,
    49.9% {
      opacity: 1;
    }

    50%,
    100% {
      opacity: 0;
    }
  }

  /* Technologies Section */
  .technologies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .technology-card {
    background: var(--bg-secondary);
    padding: 28px;
    border-radius: var(--radius-lg);
    transition: all var(--animation-duration) ease;
    animation: fadeInUp var(--animation-duration-slow) ease-out;
    border: 1px solid var(--border);
  }

  @media (hover: hover) {
    .technology-card:hover {
      border-color: var(--accent-primary);
      box-shadow: var(--shadow-sm);
    }
  }

  .technology-icon {
    font-size: 28px;
    margin-bottom: 14px;
    display: block;
    color: var(--accent-primary);
  }

  .technology-title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    margin-bottom: 12px;
    color: var(--text-primary);
  }

  .technology-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }
</style>
