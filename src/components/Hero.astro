---
import { Picture } from 'astro:assets';
import alvaroImg from '../assets/alvaro.jpg';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="hero" class="hero bg-dots">
  <div class="hero-content">
    <button
      class="hero-image-wrapper clean-btn"
      aria-label={t('hero.image.alt')}
    >
      <Picture
        src={alvaroImg}
        alt="Foto de Álvaro Lostal, desarrollador web frontend"
        widths={[180, 360]}
        sizes="180px"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="hero-image interactive-image"
        id="heroImage"
        quality={85}
      />
      <div class="profile-indicator" aria-hidden="true">
        <span class="profile-indicator__text">{t('about.title')}</span>
        <i class="profile-indicator__icon">ⓘ</i>
      </div>
    </button>
    <div class="hero-subtitle">{t('hero.greeting')}</div>
    <h1 class="hero-title typing-effect" data-text={t('hero.name')}>
      {t('hero.name')}
    </h1>
    <p class="hero-description">
      <span>{t('hero.description')}</span>
      <br /><span>{t('hero.description2')}</span>
    </p>
    <div class="hero-cta">
      <a href="#contact" class="btn btn-primary">
        <i class="fas fa-arrow-right"></i>
        <span>{t('hero.cta.contact')}</span>
      </a>
      <a href="#projects" class="btn btn-secondary">{t('hero.cta.portfolio')}</a
      >
    </div>
  </div>

  <!-- Card flotante con información personal -->
  <div class="about-card" id="aboutCard" aria-hidden="true">
    <button
      class="about-card__close"
      id="closeCard"
      aria-label={t('about.close.label')}
    >
      <i class="fas fa-times"></i>
    </button>
    <div class="about-card__content">
      <h3 class="about-card__title">{t('about.title')}</h3>
      <p class="about-card__text">
        {t('about.text')}
      </p>
      <div class="about-card__stats">
        <div class="stat">
          <span class="stat-number">2026</span>
          <span class="stat-label">{t('about.stat.graduation')}</span>
        </div>
        <div class="stat">
          <span class="stat-number">B2</span>
          <span class="stat-label">{t('about.stat.english')}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Overlay para móvil -->
  <div class="about-card-overlay" id="cardOverlay" aria-hidden="true"></div>

  <a
    href="#projects"
    class="scroll-down"
    id="scrollDown"
    aria-label={t('scroll.label')}
  >
    <i class="fas fa-angle-down"></i>
  </a>

  <script>
    // Hero Card Manager - Funcionalidad interactiva del card flotante

    import { HeroCardManager } from '../scripts/hero-card';

    // Inicializar cuando el DOM esté listo
    document.addEventListener('DOMContentLoaded', () => {
      new HeroCardManager();

      // Animación de escritura para el título
      const heroTitle = document.querySelector(
        '.hero-title.typing-effect'
      ) as HTMLElement;
      if (heroTitle) {
        const text =
          heroTitle.getAttribute('data-text') || heroTitle.textContent || '';
        heroTitle.textContent = '';
        heroTitle.classList.add('typing');

        let i = 0;
        const typeWriter = () => {
          if (i < text.length) {
            heroTitle.textContent += text.charAt(i);
            i++;
            setTimeout(typeWriter, 60);
          } else {
            // Mantener cursor parpadeando 2s y luego quitar
            setTimeout(() => {
              heroTitle.classList.remove('typing');
            }, 2000);
          }
        };

        // Retrasar inicio para que la página se estabilice
        setTimeout(typeWriter, 500);
      }
    });
  </script>
</section>
<style>
  /* src/styles/hero.css content moved here */

  /* Typing Animation Effect - Específico de Hero */
  .typing-effect {
    position: relative;
    display: inline-block;
  }

  /* Industrial dot pattern background - Technical grid aesthetic */
  .bg-dots {
    position: relative;
    isolation: isolate;
  }

  .bg-dots::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle at center,
      var(--text-tertiary) 1px,
      transparent 1px
    );
    background-size: 20px 20px;
    opacity: 0.28;
    pointer-events: none;
    z-index: 0;
    /* Fade mask for subtle edges - elipse más pequeña para fade más visible */
    mask-image: radial-gradient(
      ellipse 80% 60% at 50% 50%,
      black 40%,
      transparent 100%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 80% 60% at 50% 50%,
      black 40%,
      transparent 100%
    );
  }

  /* Mayor opacidad en modo claro para compensar bajo contraste de pantallas */
  :root:not([data-theme='dark']) .bg-dots::after {
    opacity: 0.35;
  }

  /* Hero Section */
  .hero {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 120px 24px 60px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .hero {
      height: calc(
        100dvh - var(--nav-height, 80px) - env(safe-area-inset-bottom, 0px)
      );
      box-sizing: border-box;
      padding: calc(var(--nav-height, 80px) + 20px) 24px 20px;
    }
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(
      circle,
      var(--accent-primary) 0%,
      transparent 70%
    );
    opacity: 0.03;
    animation: pulse 8s ease-in-out infinite;
    pointer-events: none;
    z-index: var(--z-background);
  }

  .hero-content {
    position: relative;
    z-index: var(--z-content);
    animation: fadeInUp 0.8s ease-out;
  }

  .hero-image-wrapper {
    margin-bottom: 32px;
    animation: fadeInUp 0.8s ease-out 0.1s both;
  }

  .hero-image {
    width: 180px;
    height: 180px;
    border-radius: var(--radius-lg);
    object-fit: cover;
    margin: 0 auto;
    border: 2px solid var(--accent-primary);
    box-shadow: 0 8px 24px rgba(var(--accent-primary-rgb), 0.15);
    transition: all var(--animation-duration) cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    position: relative;
    z-index: var(--z-hero-image);
  }

  @media (hover: hover) {
    .hero-image.interactive-image:hover {
      transform: scale(1.03) rotate(1.5deg);
      border-color: var(--accent-dark);
      box-shadow:
        0 12px 32px rgba(var(--accent-primary-rgb), 0.25),
        0 0 20px rgba(var(--accent-primary-rgb), 0.15);
    }
  }

  .hero-image.interactive-image:focus {
    outline: none;
    box-shadow:
      0 20px 60px rgba(var(--accent-primary-rgb), 0.2),
      0 0 0 3px var(--accent-primary);
  }

  .hero-image.interactive-image:active {
    transform: scale(0.98);
    transition: transform 0.1s ease;
  }

  @media (hover: hover) {
    .hero-image.interactive-image::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      border-radius: inherit;
      background: linear-gradient(
        45deg,
        transparent,
        rgba(var(--accent-primary-rgb), 0.15),
        transparent
      );
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .hero-image.interactive-image:hover::after {
      opacity: 1;
      animation: shimmer 1.5s ease-in-out infinite;
    }
  }

  /* Animación de brillo que se mueve por la imagen */
  @keyframes shimmer {
    0% {
      background: linear-gradient(
        45deg,
        transparent,
        rgba(var(--accent-primary-rgb), 0.15),
        transparent
      );
      transform: translateX(-100%);
    }

    50% {
      background: linear-gradient(
        45deg,
        transparent,
        rgba(var(--accent-primary-rgb), 0.25),
        transparent
      );
      transform: translateX(0%);
    }

    100% {
      background: linear-gradient(
        45deg,
        transparent,
        rgba(var(--accent-primary-rgb), 0.15),
        transparent
      );
      transform: translateX(100%);
    }
  }

  /* Indicador visual estático estilo Apple */
  .hero-image-wrapper {
    position: relative;
    display: inline-block;
    cursor: pointer;
    transition: transform var(--animation-duration) ease;
    border-radius: var(--radius-xl);
    outline: none;
  }

  /* Hover siempre activo (incluido móvil) */
  .hero-image-wrapper:hover {
    transform: translateY(-2px);
  }

  /* Mejor indicador de foco para accesibilidad */
  .hero-image-wrapper:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 4px;
  }

  /* Profile indicator - Original top-right position with breathing animation */
  .profile-indicator {
    position: absolute;
    top: -8px;
    right: -8px;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    color: var(--text-secondary);
    z-index: var(--z-profile-indicator);
    display: flex;
    align-items: center;
    gap: 5px;
    transition: all var(--animation-duration) ease;
    pointer-events: none;
    white-space: nowrap;
    animation: smooth-breathe 3s ease-in-out infinite;
  }

  /* Animación más fluida y visible de "respiración" */
  @keyframes smooth-breathe {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.8;
    }

    50% {
      transform: scale(1.08);
      opacity: 1;
    }
  }

  .profile-indicator__text {
    display: inline-block;
    white-space: nowrap;
  }

  .profile-indicator__icon {
    font-size: 12px;
    opacity: 0.8;
    font-style: normal;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* Hover siempre activo (incluido móvil) */
  .hero-image-wrapper:hover .profile-indicator {
    background: var(--accent-primary);
    color: var(--text-on-accent);
    border-color: var(--accent-primary);
    /* No rotation, only subtle scale */
    transform: scale(1.05) rotate(0deg);
    animation: none;
  }

  /* Ocultar indicador cuando la tarjeta está visible */
  .about-card.show ~ .hero-content .hero-image-wrapper .profile-indicator {
    opacity: 0;
    transform: scale(0.9);
  }

  /* Alternativa: ocultar cuando hay clase específica */
  .profile-indicator.hidden {
    opacity: 0;
    transform: scale(0.9);
  }

  /* Responsive adjustments */
  @media (max-width: 480px) {
    .profile-indicator {
      font-size: 10px;
      padding: 6px 10px;
      border-radius: var(--radius-xl);
      /* Usar los mismos colores que desktop sin hover */
      background: rgba(var(--bg-primary-rgb), 0.95);
      color: var(--text-secondary);
      border: 1px solid rgba(var(--accent-primary-rgb), 0.3);
      box-shadow:
        0 4px 16px rgba(0, 0, 0, 0.06),
        0 0 0 1px rgba(var(--accent-primary-rgb), 0.1);
      animation: smooth-breathe 3s ease-in-out infinite;
    }

    .profile-indicator__text {
      display: inline-block;
      font-weight: 600;
    }

    .profile-indicator__icon {
      font-size: 11px;
    }

    /* Feedback táctil para móviles */
    .hero-image-wrapper:active .hero-image {
      transform: scale(0.95);
      transition: transform 0.1s ease;
    }

    .hero-image-wrapper:active .profile-indicator {
      transform: scale(0.9);
      opacity: 0.8;
    }
  }

  /* Tema oscuro - Profile Indicator */
  [data-theme='dark'] .profile-indicator {
    background: rgba(var(--bg-secondary-rgb), 0.9);
    border-color: rgba(var(--border-rgb), 0.3);
    box-shadow: 0 4px 16px var(--shadow-md);
  }

  @media (hover: hover) {
    :root[data-theme='dark'] .hero-image-wrapper:hover .profile-indicator {
      background: var(--accent-primary);
      color: var(--text-on-accent);
      border-color: transparent;
    }
  }

  .hero-subtitle {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    color: var(--accent-primary);
    margin-bottom: 12px;
    letter-spacing: 0.5px;
    animation: fadeInUp 0.8s ease-out 0.2s both;
  }

  .hero-title {
    font-size: var(--font-size-5xl);
    font-weight: var(--font-weight-bold);
    line-height: 1;
    min-height: 64px;
    /* Prevent layout shift during typing animation */
    margin-bottom: 16px;
    letter-spacing: -2px;
    animation: fadeInUp 0.8s ease-out 0.3s both;
    /* Usar la misma duración de transición que el resto del sitio */
    transition: color var(--animation-duration, 0.3s) ease;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 80px;
      min-height: 80px;
    }
  }

  .hero-description {
    font-size: var(--font-size-lg);
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 32px;
    animation: fadeInUp 0.8s ease-out 0.4s both;
  }

  .hero-cta {
    display: inline-flex;
    gap: 16px;
    animation: fadeInUp 0.8s ease-out 0.5s both;
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 480px) {
    .hero-title {
      font-size: 48px;
    }

    .hero-description {
      font-size: 16px;
    }
  }

  /* Flecha de scroll hacia abajo */
  .scroll-down {
    position: absolute;
    bottom: 30px;
    left: 0;
    right: 0;
    margin: 0 auto;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    font-size: 20px;
    transition:
      color var(--animation-duration, 0.3s) ease,
      background var(--animation-duration, 0.3s) ease;
    /* Combinamos fade-in inicial con bounce continuo con delay para que se vea el fade-in primero */
    animation:
      fadeInUp 0.8s ease-out 0.6s both,
      bounce-dynamic 2.5s ease-in-out 1.4s infinite;
    border-radius: 50%;
    background: rgba(var(--bg-primary-rgb), 0.8);
    backdrop-filter: blur(10px);
    border: none;
    opacity: 1;
    visibility: visible;
    text-decoration: none;
  }

  .scroll-down.hidden {
    opacity: 0;
    visibility: hidden;
  }

  @media (hover: hover) {
    .scroll-down:hover {
      color: var(--accent-primary);
      background: rgba(var(--accent-primary-rgb), 0.1);
      /* Pausar la animación de bounce en hover para mejor interacción */
      animation-play-state: paused;
    }
  }

  .scroll-down i {
    line-height: 1;
    text-decoration: none;
    border: none;
    outline: none;
  }

  /* Animación de bounce más dinámica y sutil */
  @keyframes bounce-dynamic {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }

    15% {
      transform: translateY(-8px) scale(1.05);
    }

    30% {
      transform: translateY(0) scale(1);
    }

    45% {
      transform: translateY(-4px) scale(1.02);
    }

    60% {
      transform: translateY(0) scale(1);
    }

    75% {
      transform: translateY(-2px) scale(1.01);
    }
  }

  @media (max-width: 768px) {
    .scroll-down {
      bottom: 35px;
      width: 36px;
      height: 36px;
      font-size: 18px;
    }
  }

  /* Ocultar la flecha en pantallas verticales de móviles */
  @media (max-width: 768px) and (orientation: portrait) {
    .scroll-down {
      display: none;
    }
  }

  /* También ocultar en pantallas muy pequeñas independientemente de la orientación */
  @media (max-height: 600px) {
    .scroll-down {
      display: none;
    }
  }

  /* ===== CARD FLOTANTE ===== */

  /* About Card - Estilo Apple/macOS */
  .about-card {
    position: fixed;
    width: 400px;
    max-width: calc(100vw - 40px);
    background: var(--bg-primary);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    padding: 32px;
    z-index: var(--z-floating-contact);
    opacity: 0;
    visibility: hidden;
    transform: scale(0.95) translateY(-10px);
    transform-origin: left center;
    transition: all var(--animation-duration) ease;
    will-change: transform, opacity;
    pointer-events: none;
    isolation: isolate;
  }

  /* Tema oscuro para el card */
  [data-theme='dark'] .about-card {
    background: var(--bg-primary);
    border-color: var(--border);
  }

  /* Estado visible con animación iPhone-style */
  .about-card.show {
    opacity: 1;
    visibility: visible;
    transform: scale(1) translateX(0) translateY(0);
    pointer-events: auto;
  }

  /* Botón de cerrar */
  .about-card__close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    border: none;
    background: rgba(var(--text-tertiary-rgb), 0.1);
    border-radius: 50%;
    color: var(--text-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-size-sm);
    transition: all var(--animation-duration) ease;
    opacity: 0.7;
  }

  @media (hover: hover) {
    .about-card__close:hover {
      background: rgba(var(--text-tertiary-rgb), 0.2);
      opacity: 1;
      transform: scale(1.1);
    }
  }

  .about-card__close:focus {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  /* Contenido del card */
  .about-card__content {
    animation: fadeInUp 0.5s ease-out 0.2s both;
  }

  .about-card__title {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    margin-bottom: 16px;
    letter-spacing: -0.5px;
  }

  .about-card__text {
    font-size: var(--font-size-base);
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 24px;
  }

  /* Stats en el card */
  .about-card__stats {
    display: flex;
    gap: 24px;
    margin-top: 20px;
  }

  .about-card__stats .stat {
    text-align: center;
    flex: 1;
  }

  .about-card__stats .stat-number {
    display: block;
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--accent-primary);
    line-height: 1.2;
  }

  .about-card__stats .stat-label {
    display: block;
    font-size: var(--font-size-sm);
    color: var(--text-tertiary);
    margin-top: 4px;
    font-weight: var(--font-weight-medium);
  }

  /* Overlay para móvil */
  .about-card-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: var(--z-card-overlay);
    opacity: 0;
    visibility: hidden;
    transition: all var(--animation-duration) ease;
  }

  .about-card-overlay.show {
    opacity: 1;
    visibility: visible;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .about-card {
      width: 90vw;
      max-width: 400px;
      padding: 28px;
      transform: scale(0.9) translateY(50px);
      transform-origin: center center;
      /* Eliminar posicionamiento conflictivo en móvil */
      left: auto !important;
      right: auto !important;
      /* Centrado CSS como fallback */
      margin-left: auto;
      margin-right: auto;
    }

    .about-card.show {
      transform: scale(1) translateX(0) translateY(0);
    }

    .about-card__close {
      display: flex;
      /* Mostrar siempre en móvil */
    }

    .about-card__stats {
      gap: 16px;
    }

    .about-card__stats .stat-number {
      font-size: 20px;
    }
  }

  @media (max-width: 480px) {
    .about-card {
      width: 95vw;
      padding: 24px;
    }

    .about-card__title {
      font-size: 20px;
    }

    .about-card__text {
      font-size: 15px;
    }

    .about-card__stats {
      flex-direction: column;
      gap: 12px;
    }

    .about-card__stats .stat {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 0;
      border-bottom: 1px solid rgba(var(--text-tertiary-rgb), 0.1);
    }

    .about-card__stats .stat:last-child {
      border-bottom: none;
    }

    .about-card__stats .stat-number,
    .about-card__stats .stat-label {
      margin: 0;
    }
  }

  /* Ocultar botón de cerrar en desktop (solo hover/mouseleave) */
  @media (hover: hover) and (pointer: fine) {
    .about-card__close {
      display: none;
    }
  }

  /* Animación de entrada más elaborada para desktop */
  @media (min-width: 769px) {
    .about-card {
      transform: scale(0.8) translateX(-30px) translateY(-20px) rotate(-2deg);
      transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .about-card.show {
      transform: scale(1) translateX(0) translateY(0) rotate(0deg);
    }
  }

  @keyframes pulse {
    0%,
    100% {
      transform: translateX(-50%) scale(1);
      opacity: 0.03;
    }

    50% {
      transform: translateX(-50%) scale(1.1);
      opacity: 0.05;
    }
  }
</style>
