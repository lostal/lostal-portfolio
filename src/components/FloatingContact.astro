---
// Componente flotante de contacto - solo visible en desktop
import ContactLinks from './ContactLinks.astro';
---

<div id="floating-contact" class="floating-contact">
  <script src="../scripts/floating-contact.ts"></script>
  <div class="floating-contact-inner">
    <ContactLinks />
  </div>
</div>

<style>
  /* === FLOATING CONTACT WIDGET === */

  /* Widget base - oculto por defecto */
  .floating-contact {
    position: fixed;
    bottom: -45px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
  }

  /* Widget visible (flotando) */
  .floating-contact.visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    bottom: -37px;
  }

  @media (hover: hover) {
    .floating-contact.visible:hover {
      bottom: 10px;
    }
  }

  /* Contenedor interno con glassmorphism */
  .floating-contact-inner {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 20px;
    background: rgba(var(--bg-primary-rgb), 0.95);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(var(--border-rgb, 229, 231, 235), 0.3);
    border-radius: 36px;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.12),
      0 2px 16px rgba(0, 0, 0, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    position: relative;
  }

  /* Área invisible para hover estable */
  .floating-contact-inner::after {
    content: '';
    position: absolute;
    bottom: -40px;
    left: -20px;
    right: -20px;
    height: 50px;
    background: transparent;
    pointer-events: auto;
  }

  @media (hover: hover) {
    .floating-contact.visible:hover .floating-contact-inner {
      transform: translateY(-4px);
      box-shadow:
        0 16px 48px rgba(0, 0, 0, 0.15),
        0 4px 24px rgba(0, 0, 0, 0.08),
        inset 0 1px 0 rgba(255, 255, 255, 0.15);
    }
  }

  /* Animaciones de deslizamiento */
  .floating-contact.slide-down {
    animation: slideDown 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }

  .floating-contact.slide-up {
    animation: slideUp 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }

  @keyframes slideDown {
    from {
      bottom: -37px;
      opacity: 1;
    }
    to {
      bottom: -100px;
      opacity: 0;
    }
  }

  @keyframes slideUp {
    from {
      bottom: -100px;
      opacity: 0;
    }
    to {
      bottom: -37px;
      opacity: 1;
    }
  }

  /* Estado DOCKED - anclado en la sección de contacto */
  .floating-contact.docked {
    position: relative;
    bottom: auto;
    left: auto;
    transform: none;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Ocultar área de hover cuando está docked */
  .floating-contact.docked .floating-contact-inner::after {
    display: none;
  }

  /* Ocultar en móviles */
  @media (max-width: 768px), (orientation: portrait), (pointer: coarse) {
    .floating-contact {
      display: none !important;
    }
  }

  /* Tema oscuro */
  :global([data-theme='dark']) .floating-contact-inner {
    background: rgba(var(--bg-primary-rgb), 0.95);
    border: 1px solid rgba(var(--border-rgb, 66, 66, 69), 0.5);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.4),
      0 2px 16px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }
</style>
